{
  "name": "tictactoe4x4",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "4x4 Tic-Tac-Toe / Connect Four style solver API (no runtime dependencies)",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "serve": "node dist/main.js",
    "test": "tsx --test src/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/main.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
